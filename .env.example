# ========== DATABASE ==========
DATABASE_URL=postgresql://sigec_user:your_secure_password@localhost:5432/sigec_edu
DATABASE_ECHO=False

# ========== JWT & SECURITY ==========
SECRET_KEY=your-super-secret-key-change-this-in-production-min-64-chars-long-xxxxx
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== API CONFIG ==========
API_TITLE=SigecEdu API
API_VERSION=1.0.0
API_DESCRIPTION=Système intelligent de gestion de l'assiduité et de contrôle anti-corruption
ENVIRONMENT=development

# ========== CORS ==========
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ========== LOGGING ==========
LOG_LEVEL=INFO
LOG_FILE=logs/sigec_edu.log

# ========== OPTIONAL: SMTP FOR NOTIFICATIONS ==========
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@sigec-edu.ci

# ========== OPTIONAL: SMS GATEWAY ==========
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_account_sid
SMS_AUTH_TOKEN=your_auth_token
